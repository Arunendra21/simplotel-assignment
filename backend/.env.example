# Copy this file to .env and fill in what you need. Every value is optional —
# with no keys set the assistant runs in deterministic mode (retrieval + templates),
# which is enough to demo and to pass the test suite.

PORT=4000
LOG_LEVEL=info

# Provide ONE of these to switch on natural LLM phrasing of grounded answers.
# Anthropic is tried first if both are present.
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# LLM_TIMEOUT_MS=12000
